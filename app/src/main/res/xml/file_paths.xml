<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths: expose the app-cache attachment downloads to the
     system viewer (Telegram-style tap-to-open). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="attachments" path="attachments/" />
    <cache-path name="camera" path="." />
    <!-- Self-update APK downloads handed to the system installer. -->
    <cache-path name="updates" path="updates/" />
</paths>