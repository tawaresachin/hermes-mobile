<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bridge server is HTTP-only and reachable over Tailscale (100.x),
         LAN (192.168.x / 10.x) and localhost. Android's <domain> entries
         can't match raw IPs/CIDRs, so allow cleartext globally.
         Auth is enforced at the app layer (API key / JWT bearer). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
