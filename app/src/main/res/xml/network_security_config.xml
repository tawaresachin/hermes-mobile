<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext posture (deliberate, documented):
         The bridge server is HTTP-only and reachable over Tailscale
         (100.x raw IPs), LAN (192.168.x / 10.x) and localhost. Android's
         <domain> entries cannot match raw IPs/CIDRs, so cleartext must stay
         enabled for those ranges. Public hosts are GATED by the app's own
         isTrustedServerHost() check before any API call is made, but this
         layer catches mistyped public URLs at the OS even if the app guard
         is bypassed.
         Exposure boundary: cleartext traffic only goes to PRIVATE networks
         (user's own tailnet/LAN/localhost). Public traffic via Cloudflare
         tunnel is TLS-terminated by cloudflared before it reaches the
         bridge. Auth (API key bearer) is enforced at the app layer. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Redundant belt-and-braces only. `base-config` above already permits
         cleartext everywhere (Android <domain> cannot match raw 100.x/
         192.168.x IPs, so the permissive base is REQUIRED for Tailscale/LAN).
         This block therefore does NOT restrict public hosts — the app's
         isTrustedServerHost() guard is the only thing that does. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">*.local</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
